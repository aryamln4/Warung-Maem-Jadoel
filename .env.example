# Salin file ini menjadi .env di hosting dan isi nilai dari panel InfinityFree.
# Jangan commit, mengirim, atau mengunggah .env berisi kredensial ke tempat publik.
APP_ENV=production
APP_DEBUG=0
APP_URL=
APP_TIMEZONE=Asia/Jakarta

DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_NAME=if0_XXXXXXXX_database
DB_USER=if0_XXXXXXXX
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Warung Maem Jadoel

PAYMENT_PROVIDER=midtrans
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
