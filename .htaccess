# Shared-hosting-safe Apache rules (avoid Options directives).
DirectoryIndex index.php

<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Preserve the app's public asset URLs while files live under public/assets.
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    # Internal source/config folders must not be served directly.
    RewriteRule ^(config|controller|model|services|view|database|docs|vendor)(/|$) - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|\.env\.|\.(sql|log|ini|lock|md|bak|dist|old|swp)$|composer\.(json|lock)$|^\.git|^\.ht)">
        Require all denied
    </FilesMatch>
</IfModule>
