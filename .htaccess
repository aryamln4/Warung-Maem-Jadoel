# Proteksi folder aplikasi Warung Maem Jadoel
# Semua eksekusi harus lewat /public/index.php — file internal & rahasia tidak boleh dilayani.

# Matikan directory listing
Options -Indexes

# Blokir file rahasia & file teknis: .env (kredensial DB/pembayaran), backup, log, dump
<FilesMatch "(\.env|\.env\.|~\.?|\.bak|\.sql|\.log|\.ini|\.lock|\.md)$">
    Require all denied
</FilesMatch>

# Blokir file dot apa pun (mis. .git, .env, .DS_Store)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
